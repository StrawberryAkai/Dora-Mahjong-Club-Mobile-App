# Copy this file to .env before running Flutter.
# local: sample data saved on this device, NO database connection (previously demo).
# development: shared data from the configured Supabase project.
APP_MODE=local

# Required only when APP_MODE=development.
# Project Settings > API: project URL and client publishable key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# NEVER add service_role, sb_secret keys, or administrator passwords here.
# This file is bundled into the mobile application and is publicly readable.
